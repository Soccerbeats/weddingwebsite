# Database Configuration
POSTGRES_USER=wedding_user
POSTGRES_PASSWORD=change_me_to_strong_password
POSTGRES_DB=wedding_db

# Application Configuration
DATABASE_URL=postgres://wedding_user:change_me_to_strong_password@db:5432/wedding_db
ADMIN_PASSWORD=password #CHANGEME
# Optional: signs the admin session cookie. Defaults to ADMIN_PASSWORD when unset.
# JWT_SECRET=a-long-random-string

# Optional: flight lookup on a honeymoon travel leg ("Fill in from schedule").
# A RapidAPI key subscribed to AeroDataBox — https://rapidapi.com/aedbx-aedbx/api/aerodatabox
# Without it the button says so instead of failing; nothing else needs it.
# FLIGHT_API_KEY=
# Only if AeroDataBox ever changes host; the default is aerodatabox.p.rapidapi.com
# FLIGHT_API_HOST=

# Optional: your own OSRM for driving times. Defaults to the public demo server.
# OSRM_URL=https://router.project-osrm.org

# Optional: RSVP email notifications (nodemailer over SMTP).
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=app-password
# NOTIFICATION_EMAIL=couple@example.com

# Optional: identifies this instance to Nominatim, per their usage policy.
# GEOCODER_USER_AGENT=WeddingWebsite-HoneymoonPortal/1.0 (you@example.com)

# Environment
NODE_ENV=development
